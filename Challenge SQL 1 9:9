CREATE OR REPLACE FUNCTION get_customer_spending(p_customer_id INT) RETURNS NUMERIC AS $$ BEGIN RETURN (
    SELECT COALESCE(SUM(total), 0)
        FROM invoice
        WHERE customer_id = p_customer_id
);
END; 
$$ LANGUAGE plpgsql;
CREATE OR REPLACE PROCEDURE update_employee_manager(p_employee_id INT, p_new_manager_id INT) LANGUAGE plpgsql
AS $$ BEGIN IF p_employee_id = p_new_manager_id THEN RAISE EXCEPTION 'Employee cannot report to themselves';
END IF;
IF NOT EXISTS ( SELECT 1 FROM employee WHERE employee_id = p_employee_id) THEN RAISE EXCEPTION 'Employee does not exist';
END IF;
IF NOT EXISTS (SELECT 1 FROM employee WHERE employee_id = p_new_manager_id) THEN RAISE EXCEPTION 'Manager does not exist';
END IF;
IF EXISTS ( WITH RECURSIVE manager_chain AS ( SELECT employee_id, reports_to FROM employee WHERE employee_id = p_new_manager_id
UNION ALL SELECT e.employee_id, e.reports_to FROM employee e JOIN manager_chain mc ON e.employee_id = mc.reports_to)
SELECT 1 FROM manager_chain WHERE employee_id = p_employee_id) THEN RAISE EXCEPTION 'Circular management relationship detected';
END IF;
UPDATE employee SET reports_to = p_new_manager_id WHERE employee_id = p_employee_id;
END; $$;
CREATE SCHEMA IF NOT EXISTS pets;
CREATE TABLE IF NOT EXISTS pets.customer ( customer_id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY, name TEXT NOT NULL,
email TEXT UNIQUE);
CREATE TABLE IF NOT EXISTS pets.pet(pet_id INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY, customer_id INTEGER NOT NULL, name TEXT NOT NULL,
species TEXT NOT NULL, age INT CHECK (age >= 0), FOREIGN KEY (customer_id) REFERENCES pets.customer(customer_id)
ON DELETE CASCADE);
